# Laki sound settings for THIS bird - read by laki-send.sh / laki-receiver.sh at every start.
# Edit, then stop and start the bird. Flags typed by hand still override these.
export LAKI_VOLUME=75          # output level % (100 = 0 dB)
export LAKI_PRIME_MS=200       # output lead ms; raise if xrun lines appear
export LAKI_LATENCY=0.3        # PortAudio buffer s
export LAKI_TRAIN_LEVEL=0.08   # min whistle level accepted in training (sender only)
FLAGS=""
FLAGS="$FLAGS --birdiness 0.3"   # 0 faithful whistle .. 1 full bird
FLAGS="$FLAGS --reverb 0.12"     # wet amount 0..1
FLAGS="$FLAGS --dry 0.7"         # direct voice 0..1
FLAGS="$FLAGS --stages 1"        # reverb passes 1-3
FLAGS="$FLAGS --tail 0.6"        # reverb tail s
FLAGS="$FLAGS --texture 0.25"    # bird grain 0..1
FLAGS="$FLAGS --bend 0.3"        # per-note bend, semitones
FLAGS="$FLAGS --hum 1"           # 1 accept hum, 0 whistles only
# FLAGS="$FLAGS --shift -12"     # pitch in semitones (12 = octave); commented = auto
